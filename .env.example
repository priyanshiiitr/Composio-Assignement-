# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional — defaults to openai/gpt-oss-120b (llama-3.3-70b-versatile is deprecated)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional but recommended for Vercel (durable generated-guide links across cold starts)
# Create a free Redis DB at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
